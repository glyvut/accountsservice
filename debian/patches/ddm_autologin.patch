+static gboolean
+load_autologin_ddm (Daemon   *daemon,
+                    gchar   **name,
+                    gboolean *enabled,
+                    GError  **error)
+{
+        g_autoptr (GKeyFile) keyfile = NULL;
+        GError *local_error = NULL;
+        g_autofree gchar *string = NULL;
+
+        keyfile = g_key_file_new ();
+        if (!g_key_file_load_from_file (keyfile,
+                                        PATH_DDM_CONF,
+                                        G_KEY_FILE_KEEP_COMMENTS,
+                                        error)) {
+                return FALSE;
+        }
+
+        string = g_key_file_get_string (keyfile, "Autologin", "User", &local_error);
+        if (local_error) {
+                g_propagate_error (error, local_error);
+                return FALSE;
+        }
+
+        *name = g_steal_pointer (&string);
+        *enabled = ((*name) && (*name)[0] != 0);
+
+        return TRUE;
+}
