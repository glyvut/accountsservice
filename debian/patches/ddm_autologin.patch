                 return save_autologin_gdm (daemon, name, enabled, error);
+        else if (dm_type == DISPLAY_MANAGER_TYPE_DEEPIN)
+                return save_autologin_ddm (daemon, name, enabled, error);
 
         /* Default to GDM for backward compatibility */
         return save_autologin_gdm (daemon, name, enabled, error);
