 static gboolean
+save_autologin_ddm (Daemon      *daemon,
+                    const gchar *name,
+                    gboolean     enabled,
+                    GError     **error)
+{
+        g_autoptr (GKeyFile) keyfile = NULL;
+        g_autofree gchar *data = NULL;
+        gboolean result;
+        g_autoptr (GError) local_error = NULL;
+        g_autofree gchar *session = NULL;
+
+        keyfile = g_key_file_new ();
+        if (!g_key_file_load_from_file (keyfile,
+                                        PATH_DDM_CONF,
+                                        G_KEY_FILE_KEEP_COMMENTS,
+                                        &local_error)) {
+                /* It's OK for ddm.conf to not exist, we will make it */
+                if (!g_error_matches (local_error, G_FILE_ERROR, G_FILE_ERROR_NOENT)) {
+                        g_propagate_error (error, g_steal_pointer (&local_error));
+                        return FALSE;
+                }
+        }
+
+        session = g_key_file_get_string (keyfile, "Autologin", "Session", NULL);
+
+        g_key_file_set_string (keyfile, "Autologin", "User", enabled ? name : "");
+        g_key_file_set_string (keyfile, "Autologin", "Session", session ? session : "");
+
+        data = g_key_file_to_data (keyfile, NULL, NULL);
+        result = g_file_set_contents (PATH_DDM_CONF, data, -1, error);
+
+        return result;
+}
+
+static gboolean
 save_autologin (Daemon      *daemon,
                 const gchar *name,
                 gboolean     enabled,
